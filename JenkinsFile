
pipeline {
    agent any

    parameters {
        choice(
            name: 'TEST_SUITE',
            choices: ['all', 'smoke', 'regression', 'api'],
            description: 'Select the Playwright test suite'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Run Playwright Tests') {
            steps {
                script {
                    if (params.TEST_SUITE == 'all') {
                        bat 'npx playwright test'
                    } else if (params.TEST_SUITE == 'smoke') {
                        bat 'npx playwright test --grep "@smoke"'
                    } else if (params.TEST_SUITE == 'regression') {
                        bat 'npx playwright test --grep "@regression"'
                    } else if (params.TEST_SUITE == 'api') {
                        bat 'npx playwright test --project=API'
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed.'
        }
        success {
            echo 'Selected test suite passed.'
        }
        failure {
            echo 'Build failed. Check Console Output.'
        }
    }
}
